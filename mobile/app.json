{
  "expo": {
    "name": "SugoiNote",
    "slug": "sugoinote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sugoinote.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sugoinote.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para adjuntar imágenes en el chat y la comunidad."
        }
      ],
      "expo-font"
    ],
    "scheme": "sugoinote",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d2947af5-685a-40d3-8211-1b9a077da826"
      }
    },
    "owner": "unice7"
  }
}
