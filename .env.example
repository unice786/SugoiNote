# Copia este archivo como .env y completa los valores.
# El .env es local: contiene secretos y esta ignorado por Git.

# Contrasena del SQL Server desechable de pruebas.
SQL_SA_PASSWORD=SugoiNote_Pruebas_2026!

# Clave de Google Gemini. Solo la usa el contenedor de pruebas para los
# endpoints de IA (chat, resumenes, examenes). Si se deja vacia, esos
# endpoints responden con error controlado y la coleccion lo refleja.
IA_API_KEY=
