# Copia este archivo como .env y completa los valores.
# El .env es local: contiene secretos y esta ignorado por Git.

# Contrasena del SQL Server desechable de pruebas.
SQL_SA_PASSWORD=SugoiNote_Pruebas_2026!

# ── Inteligencia artificial ──────────────────────────────────
# Proveedor: "openai" para cualquier API compatible con OpenAI
# (DeepSeek, ModelScope, Groq...) o "gemini" para Google AI Studio.
IA_PROVEEDOR=openai
IA_BASE_URL=https://api.deepseek.com/v1

# Clave del proveedor. Si se deja vacia, los endpoints de IA responden con un
# error controlado ("La inteligencia artificial no esta configurada").
IA_API_KEY=

# Modelos. Con DeepSeek los disponibles son deepseek-flash y deepseek-v4-pro.
# Con Gemini, por ejemplo gemini-3.8-flash y gemini-3.1-flash-lite.
IA_MODEL=deepseek-flash
IA_MODEL_FAST=deepseek-flash
