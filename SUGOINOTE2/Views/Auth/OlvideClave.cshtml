@model SugoiNote.Models.ViewModels.OlvideClaveVM
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="form-section">
        <div class="logo-area">
            <div class="logo-icon-bg" aria-hidden="true"><i class="bi bi-journal-bookmark-fill"></i></div>
            SugoiNote
        </div>

        <div class="welcome-header">
            <h1>Recuperar contraseña</h1>
            <p>Te enviaremos un enlace para crear una nueva contraseña</p>
        </div>

        @if (TempData["Exito"] is string exito)
        {
            <div class="validation-summary-errors" role="status" style="background:color-mix(in srgb, var(--success) 10%, transparent);border-color:color-mix(in srgb, var(--success) 30%, transparent);color:var(--success);">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i> @exito
            </div>
        }

        @if (ViewBag.TokenDesarrollo is string tokenDev)
        {
            <div class="validation-summary-errors" role="status">
                <strong>Modo desarrollo: no hay SMTP configurado.</strong><br />
                Enlace directo:
                <a href="/Auth/Restablecer?token=@Uri.EscapeDataString(tokenDev)">restablecer contraseña</a>
            </div>
        }

        <form asp-controller="Auth" asp-action="OlvideClave" method="post" autocomplete="on">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="input-group">
                <label for="CorreoElectronico">Correo electrónico</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <input asp-for="CorreoElectronico" id="CorreoElectronico" type="email"
                           placeholder="estudiante@ejemplo.com" autocomplete="username" required autofocus />
                </div>
                <span asp-validation-for="CorreoElectronico" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-auth">Enviar enlace</button>
            <a href="/Auth/Login" class="btn-ghost-auth mt-2" style="display:block;text-align:center;text-decoration:none;">
                Volver al inicio de sesión
            </a>
        </form>
    </div>
</div>