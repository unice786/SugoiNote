@model SugoiNote.Models.ViewModels.LoginVM
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="form-section">
        <div class="logo-area">
            <div class="logo-icon-bg" aria-hidden="true"><i class="bi bi-journal-bookmark-fill"></i></div>
            SugoiNote
        </div>

        <div class="welcome-header">
            <h1>Bienvenido de vuelta</h1>
            <p>Ingresa tus datos para continuar</p>
        </div>

        <form asp-controller="Auth" asp-action="Login" method="post" autocomplete="on">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="input-group">
                <label for="CorreoElectronico">Correo electrónico</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <input asp-for="CorreoElectronico" id="CorreoElectronico" type="email"
                           placeholder="estudiante@ejemplo.com"
                           autocomplete="username" required autofocus />
                </div>
                <span asp-validation-for="CorreoElectronico" class="field-validation-error"></span>
            </div>

            <div class="input-group">
                <label for="ClaveAcceso">Contraseña</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                    <input asp-for="ClaveAcceso" id="ClaveAcceso" type="password"
                           placeholder="••••••••"
                           autocomplete="current-password" required />
                </div>
                <span asp-validation-for="ClaveAcceso" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-auth">Iniciar sesión</button>

            @* FIX C1: antes este modal pedía correo + nueva contraseña y sobrescribía el hash
               sin comprobar nada. Ahora el cambio exige un token de un uso por email. *@
            <a href="/Auth/OlvideClave" class="btn-ghost-auth mt-2" style="display:block;text-align:center;text-decoration:none;">
                ¿Olvidaste tu contraseña?
            </a>
        </form>

        <div class="switch-auth">
            ¿No tienes cuenta? <a href="/Auth/Register">Regístrate aquí</a>
        </div>
    </div>

    <div class="info-section">
        <div class="feature-card">
            <div class="feature-icon-box" aria-hidden="true"><i class="bi bi-stars"></i></div>
            <div class="feature-text">
                <h3>Resúmenes con IA</h3>
                <p>Genera resúmenes automáticamente a partir de tus notas largas.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon-box" aria-hidden="true"><i class="bi bi-journal-text"></i></div>
            <div class="feature-text">
                <h3>Organiza tus apuntes</h3>
                <p>Clasifica tus notas por materias, temas y fechas fácilmente.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon-box" aria-hidden="true"><i class="bi bi-clipboard-check"></i></div>
            <div class="feature-text">
                <h3>Exámenes personalizados</h3>
                <p>Practica con tests generados por la IA basados en tus estudios.</p>
            </div>
        </div>
    </div>
</div>