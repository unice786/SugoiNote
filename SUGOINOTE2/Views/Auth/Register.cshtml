@model SugoiNote.Models.ViewModels.RegistroVM
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="form-section">
        <div class="logo-area">
            <div class="logo-icon-bg" aria-hidden="true"><i class="bi bi-journal-bookmark-fill"></i></div>
            SugoiNote
        </div>

        <div class="welcome-header">
            <h1>Crea tu cuenta</h1>
            <p>Únete para empezar a estudiar inteligentemente</p>
        </div>

        <form asp-controller="Auth" asp-action="Register" method="post" autocomplete="on">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="input-group">
                <label for="NombreCompleto">Nombre completo</label>
                <div class="input-wrapper">
                    <i class="bi bi-person" aria-hidden="true"></i>
                    <input asp-for="NombreCompleto" id="NombreCompleto" type="text"
                           placeholder="Juan Pérez" maxlength="150"
                           autocomplete="name" required autofocus />
                </div>
                <span asp-validation-for="NombreCompleto" class="field-validation-error"></span>
            </div>

            <div class="input-group">
                <label for="CorreoElectronico">Correo electrónico</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <input asp-for="CorreoElectronico" id="CorreoElectronico" type="email"
                           placeholder="estudiante@ejemplo.com"
                           autocomplete="username" required />
                </div>
                <span asp-validation-for="CorreoElectronico" class="field-validation-error"></span>
            </div>

            <div class="input-group">
                <label for="ClaveAcceso">Contraseña</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                    <input asp-for="ClaveAcceso" id="ClaveAcceso" type="password"
                           placeholder="Mínimo 8 caracteres, con letra y número"
                           autocomplete="new-password" required minlength="8" />
                </div>
                <span asp-validation-for="ClaveAcceso" class="field-validation-error"></span>
            </div>

            <div class="input-group">
                <label for="ConfirmarClave">Repetir contraseña</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                    <input asp-for="ConfirmarClave" id="ConfirmarClave" type="password"
                           placeholder="Repite la contraseña"
                           autocomplete="new-password" required minlength="8" />
                </div>
                <span asp-validation-for="ConfirmarClave" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-auth">Registrarme</button>
        </form>

        <div class="switch-auth">
            ¿Ya tienes cuenta? <a href="/Auth/Login">Inicia sesión</a>
        </div>
    </div>

    <div class="info-section">
        <div class="feature-card">
            <div class="feature-icon-box" aria-hidden="true"><i class="bi bi-stars"></i></div>
            <div class="feature-text">
                <h3>Resúmenes con IA</h3>
                <p>Genera resúmenes automáticamente a partir de tus notas largas.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon-box" aria-hidden="true"><i class="bi bi-journal-text"></i></div>
            <div class="feature-text">
                <h3>Organiza tus apuntes</h3>
                <p>Clasifica tus notas por materias, temas y fechas fácilmente.</p>
            </div>
        </div>
        <div class="feature-card">
            <div class="feature-icon-box" aria-hidden="true"><i class="bi bi-clipboard-check"></i></div>
            <div class="feature-text">
                <h3>Exámenes personalizados</h3>
                <p>Practica con tests generados por la IA basados en tus estudios.</p>
            </div>
        </div>
    </div>
</div>