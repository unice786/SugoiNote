@model SugoiNote.Models.Apunte
@{
    ViewData["Title"] = Model?.TituloNota ?? "Editor";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/Apuntes/Index" class="btn-ghost" style="padding:8px 14px;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div style="flex:1;">
        <input type="text" id="tituloEditor" value="@Model?.TituloNota"
               style="background:none;border:none;color:var(--text-main);font-size:1.4rem;font-weight:800;font-family:inherit;width:100%;padding:0;"
               placeholder="Sin título..." />
    </div>
    <span class="autosave-badge" id="autosaveBadge">
        <i class="bi bi-circle" style="font-size:0.6rem;"></i> Sin cambios
    </span>
    <button class="btn-sugoi" onclick="guardarManual()">
        <i class="bi bi-floppy"></i> Guardar
    </button>

    <!-- MENÚ 3 PUNTOS -->
    <div style="position:relative;">
        <button id="btnMenu" onclick="toggleMenu()" class="btn-ghost" style="padding:8px 12px;font-size:1.2rem;">
            <i class="bi bi-three-dots-vertical"></i>
        </button>
        <div id="menuOpciones" style="display:none;position:absolute;right:0;top:110%;background:var(--panel-bg, #0b0c10);border:1px solid var(--border-color, #1a1b26);border-radius:12px;padding:6px;min-width:160px;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,0.4);">
            <button onclick="abrirModalEliminar()" style="width:100%;background:none;border:none;color:#ff4d4f;padding:10px 14px;text-align:left;border-radius:8px;cursor:pointer;font-size:0.9rem;display:flex;align-items:center;gap:8px;">
                <i class="bi bi-trash"></i> Eliminar apunte
            </button>
        </div>
    </div>
</div>

<div class="editor-wrapper">
    <div class="editor-toolbar">
        <button onclick="fmt('bold')"><b>B</b></button>
        <button onclick="fmt('italic')"><i>I</i></button>
        <button onclick="fmt('underline')"><u>U</u></button>
        <div style="width:1px;height:20px;background:var(--border);margin:0 6px;"></div>
        <button onclick="fmt('insertUnorderedList')"><i class="bi bi-list-ul"></i></button>
        <button onclick="fmt('insertOrderedList')"><i class="bi bi-list-ol"></i></button>
        <div style="width:1px;height:20px;background:var(--border);margin:0 6px;"></div>
        <button onclick="fmt('formatBlock','H2')" style="font-size:0.75rem;font-weight:700;">H2</button>
        <button onclick="fmt('formatBlock','H3')" style="font-size:0.75rem;font-weight:700;">H3</button>
        <button onclick="fmt('formatBlock','P')" style="font-size:0.75rem;">¶</button>
    </div>
    <div id="editorContent"
         class="editor-area"
         contenteditable="true"
         spellcheck="true">
        @Html.Raw(Model?.ContenidoTexto ?? "")
    </div>
</div>

<input type="hidden" id="apunteId" value="@Model?.ApunteId" />

<!-- MODAL CONFIRMAR ELIMINAR -->
<div id="modalEliminar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:999;align-items:center;justify-content:center;">
    <div style="background:var(--panel-bg,#0b0c10);border:1px solid var(--border-color,#1a1b26);border-radius:20px;padding:30px;width:100%;max-width:400px;margin:0 16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <h3 style="margin:0;color:#ff4d4f;font-size:1.1rem;"><i class="bi bi-exclamation-triangle"></i> Eliminar apunte</h3>
            <button onclick="cerrarModalEliminar()" style="background:none;border:none;color:var(--text-muted,#808085);font-size:1.3rem;cursor:pointer;">&times;</button>
        </div>
        <p style="color:var(--text-muted,#808085);font-size:0.9rem;margin-bottom:24px;">¿Estás seguro que deseas eliminar <strong style="color:white;">@Model?.TituloNota</strong>? Esta acción no se puede deshacer.</p>
        <div style="display:flex;gap:8px;">
            <button onclick="confirmarEliminar()" style="flex:1;background:#ff4d4f;color:white;border:none;padding:12px;border-radius:12px;font-size:0.95rem;font-weight:700;cursor:pointer;">
                <i class="bi bi-trash"></i> Sí, eliminar
            </button>
            <button onclick="cerrarModalEliminar()" class="btn-ghost">Cancelar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timer;
        const badge = document.getElementById('autosaveBadge');
        const editor = document.getElementById('editorContent');

        function fmt(cmd, val) {
            document.execCommand(cmd, false, val || null);
            editor.focus();
        }

        function setBadge(estado) {
            badge.className = 'autosave-badge' + (estado === 'saved' ? ' saved' : '');
            badge.innerHTML = estado === 'saved'
                ? '<i class="bi bi-check-circle" style="font-size:0.75rem;"></i> Guardado'
                : '<i class="bi bi-circle" style="font-size:0.6rem;"></i> Sin guardar';
        }

        async function guardar() {
            const id = document.getElementById('apunteId').value;
            const titulo = document.getElementById('tituloEditor').value;
            const contenido = editor.innerHTML;
            try {
                const res = await fetch('/Apuntes/AutoSave', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value || '' },
                    body: JSON.stringify({ apunteId: id, titulo: titulo, contenido: contenido })
                });
                if (res.ok) setBadge('saved');
            } catch(e) {}
        }

        function guardarManual() { clearTimeout(timer); guardar(); }

        editor.addEventListener('input', () => {
            setBadge('unsaved');
            clearTimeout(timer);
            timer = setTimeout(guardar, 2000);
        });

        document.getElementById('tituloEditor').addEventListener('input', () => {
            setBadge('unsaved');
            clearTimeout(timer);
            timer = setTimeout(guardar, 2000);
        });

        // MENÚ 3 PUNTOS
        function toggleMenu() {
            const menu = document.getElementById('menuOpciones');
            menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
        }

        document.addEventListener('click', function(e) {
            const btn = document.getElementById('btnMenu');
            const menu = document.getElementById('menuOpciones');
            if (!btn.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
            }
        });

        // ELIMINAR
        function abrirModalEliminar() {
            document.getElementById('menuOpciones').style.display = 'none';
            document.getElementById('modalEliminar').style.display = 'flex';
        }

        function cerrarModalEliminar() {
            document.getElementById('modalEliminar').style.display = 'none';
        }

        async function confirmarEliminar() {
            const id = document.getElementById('apunteId').value;
            try {
                const res = await fetch('/Apuntes/Eliminar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apunteId: id })
                });
                if (res.ok) {
                    window.location.href = '/Apuntes/Index';
                } else {
                    alert('Error al eliminar. Intenta de nuevo.');
                }
            } catch(e) {
                alert('Error al eliminar. Intenta de nuevo.');
            }
        }
    </script>
    @Html.AntiForgeryToken()
}