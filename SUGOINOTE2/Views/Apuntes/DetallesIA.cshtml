@model SugoiNote.Models.Apunte
@{
    ViewData["Title"] = "Detalle del Apunte";
}
<style>
    .detail-card { background: linear-gradient(145deg, #151b2e, #1a2035); border: 1px solid rgba(255,255,255,0.06); border-radius: 20px; padding: 36px; }
    .content-box { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 24px; line-height: 1.8; color: #cbd5e1; font-size: 0.95rem; min-height: 200px; white-space: pre-wrap; }
    .btn-neon { background: linear-gradient(135deg, #8b5cf6, #d946ef); border: none; color: white; border-radius: 12px; font-weight: 600; padding: 12px 28px; font-size: 0.95rem; box-shadow: 0 4px 15px rgba(139,92,246,0.35); cursor: pointer; transition: all 0.2s; }
    .btn-neon:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(139,92,246,0.5); color: white; }
    .btn-neon:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .btn-back { color: #6b7280; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px; transition: color 0.2s; }
    .btn-back:hover { color: #a78bfa; }
    .text-gradient { background: linear-gradient(to right, #a78bfa, #f472b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .resumen-box { background: linear-gradient(135deg, rgba(139,92,246,0.1), rgba(217,70,239,0.05)); border: 1px solid rgba(139,92,246,0.3); border-radius: 12px; padding: 24px; line-height: 1.8; color: #e2e8f0; font-size: 0.95rem; white-space: pre-wrap; }
    .loading-dots span { display: inline-block; animation: bounce 1.2s infinite; font-size: 1.5rem; }
    .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
    .loading-dots span:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes bounce { 0%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-8px); } }
</style>

<div class="mb-4">
    <a asp-controller="Apuntes" asp-action="Index" class="btn-back">← Volver a mis apuntes</a>
</div>

<div class="detail-card">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-bold text-gradient mb-2">@Model.TituloNota</h2>
            @if (Model.FechaRegistro.HasValue)
            {
                <small style="color:#4b5563;">📅 @Model.FechaRegistro.Value.ToString("dd MMMM yyyy, HH:mm")</small>
            }
        </div>
    </div>

    <h6 style="color:#6b7280;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:12px;">Contenido</h6>
    <div class="content-box mb-4">@(string.IsNullOrWhiteSpace(Model.ContenidoTexto) ? "Este apunte no tiene contenido." : Model.ContenidoTexto)</div>

    @if (!string.IsNullOrWhiteSpace(Model.ResumenGeneradoIA))
    {
        <h6 style="color:#6b7280;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:12px;">✨ Resumen IA</h6>
        <div class="resumen-box">@Model.ResumenGeneradoIA</div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 mt-2">
            <button class="btn-neon" id="btnGenerar" onclick="generarResumen()">✨ Generar resumen con IA</button>
            <small style="color:#4b5563;">El resumen se guardará automáticamente</small>
        </div>
        <div id="loadingState" style="display:none;" class="mt-4 text-center">
            <div class="loading-dots"><span>●</span><span>●</span><span>●</span></div>
            <p style="color:#6b7280;font-size:0.85rem;margin-top:8px;">Generando resumen con IA...</p>
        </div>
        <div id="resumenBox" class="resumen-box mt-4" style="display:none;"></div>
    }
</div>

@section Scripts {
<script>
async function generarResumen() {
    const btn = document.getElementById('btnGenerar');
    const loading = document.getElementById('loadingState');
    const resumenBox = document.getElementById('resumenBox');
    btn.disabled = true;
    btn.textContent = '⏳ Generando...';
    loading.style.display = 'block';

    const contenido = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContenidoTexto ?? ""));
    const titulo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TituloNota));
    const apunteId = '@Model.ApunteId';

    try {
        const response = await fetch('/api/apuntes/resumir', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ apunteId, titulo, contenido })
        });
        const data = await response.json();
        if (data.resumen) {
            resumenBox.textContent = data.resumen;
            resumenBox.style.display = 'block';
            loading.style.display = 'none';
            btn.style.display = 'none';
        } else {
            throw new Error(data.error || 'Error desconocido');
        }
    } catch (err) {
        loading.style.display = 'none';
        btn.disabled = false;
        btn.textContent = '✨ Generar resumen con IA';
        alert('Error: ' + err.message);
    }
}
</script>
}