@{
    ViewData["Title"] = "Chat IA";
}

<div style="height:calc(100vh - 120px);display:flex;flex-direction:column;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:42px;height:42px;background:rgba(139,92,246,0.15);border-radius:12px;display:flex;align-items:center;justify-content:center;">
            <i class="bi bi-robot" style="color:var(--neon-purple);font-size:1.1rem;"></i>
        </div>
        <div>
            <h2 style="font-weight:800;font-size:1.4rem;margin:0;">Chat IA</h2>
            <p style="color:var(--text-muted);font-size:0.82rem;margin:0;">Tu tutor académico personal</p>
        </div>
        <button class="btn-ghost" onclick="limpiarChat()" style="margin-left:auto;padding:8px 16px;font-size:0.82rem;">
            <i class="bi bi-trash3"></i> Limpiar
        </button>
    </div>

    <div id="chatBox" style="flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:16px;padding:4px 0 20px;">
        <div class="msg-ia">
            <div class="msg-avatar ia"><i class="bi bi-robot"></i></div>
            <div class="msg-burbuja ia">
                ¡Hola! Soy tu asistente de estudio potenciado por IA. ¿En qué puedo ayudarte hoy? Puedo ayudarte a explicar conceptos, resolver dudas o generar ejercicios de práctica.
            </div>
        </div>
    </div>

    <div style="border-top:1px solid var(--border);padding-top:16px;">
        <div style="display:flex;gap:10px;align-items:flex-end;">
            <textarea id="inputMsg"
                      placeholder="Escribe tu pregunta sobre cualquier tema..."
                      style="flex:1;background:var(--card-bg);border:1px solid var(--border);color:var(--text-main);border-radius:14px;padding:12px 16px;font-family:inherit;font-size:0.9rem;resize:none;min-height:48px;max-height:120px;line-height:1.5;"
                      rows="1"
                      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();enviar();}"></textarea>
            <button onclick="enviar()" id="btnEnviar"
                    style="width:46px;height:46px;background:var(--neon-purple);border:none;border-radius:12px;color:white;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;flex-shrink:0;">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
        <p style="color:var(--text-muted);font-size:0.72rem;text-align:center;margin-top:8px;">La IA puede cometer errores. Verifica la información importante.</p>
    </div>
</div>

<style>
    .msg-ia, .msg-user { display:flex; gap:10px; align-items:flex-start; }
    .msg-user { flex-direction:row-reverse; }
    .msg-avatar {
        width:34px; height:34px; border-radius:10px;
        display:flex; align-items:center; justify-content:center;
        font-size:0.9rem; flex-shrink:0;
    }
    .msg-avatar.ia { background:rgba(139,92,246,0.15); color:var(--neon-purple); }
    .msg-avatar.user { background:rgba(139,92,246,0.9); color:white; font-weight:700; font-size:0.75rem; }
    .msg-burbuja {
        max-width:72%; padding:12px 16px; border-radius:14px;
        font-size:0.9rem; line-height:1.6;
    }
    .msg-burbuja.ia {
        background:var(--card-bg);
        border:1px solid var(--border);
        color:var(--text-main);
        border-top-left-radius:4px;
    }
    .msg-burbuja.user {
        background:var(--neon-purple);
        color:white;
        border-top-right-radius:4px;
    }
    .msg-burbuja.typing { color:var(--text-muted); font-style:italic; }
    @@keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
    .msg-ia, .msg-user { animation: fadeIn 0.2s ease; }
</style>

@section Scripts {
    <script>
        let historial = [];
        const chatBox = document.getElementById('chatBox');
        const input = document.getElementById('inputMsg');
        const btn = document.getElementById('btnEnviar');
        const iniciales = '@(User.Identity?.Name?.Substring(0, Math.Min(User.Identity?.Name?.Length ?? 2, 2)).ToUpper() ?? "U")';

        function scrollAbajo() {
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function agregarMensaje(texto, esUsuario, esTyping = false) {
            const div = document.createElement('div');
            div.className = esUsuario ? 'msg-user' : 'msg-ia';
            const avatar = `<div class="msg-avatar ${esUsuario ? 'user' : 'ia'}">${esUsuario ? iniciales : '<i class="bi bi-robot"></i>'}</div>`;
            const burbuja = `<div class="msg-burbuja ${esUsuario ? 'user' : 'ia'} ${esTyping ? 'typing' : ''}" id="${esTyping ? 'typing-indicator' : ''}">${texto}</div>`;
            div.innerHTML = esUsuario ? burbuja + avatar : avatar + burbuja;
            chatBox.appendChild(div);
            scrollAbajo();
            return div;
        }

        async function enviar() {
            const msg = input.value.trim();
            if (!msg) return;

            agregarMensaje(msg, true);
            historial.push({ texto: msg, esUsuario: true });
            input.value = '';
            input.style.height = 'auto';
            btn.disabled = true;

            agregarMensaje('Escribiendo...', false, true);

            try {
                const res = await fetch('/Chat/Enviar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        mensaje: msg,
                        historial: historial.slice(-10)
                    })
                });

                const typing = document.getElementById('typing-indicator');
                if (typing) typing.closest('.msg-ia').remove();

                if (res.ok) {
                    const data = await res.json();
                    agregarMensaje(data.respuesta, false);
                    historial.push({ texto: data.respuesta, esUsuario: false });
                } else {
                    agregarMensaje('Hubo un error al obtener respuesta. Intenta de nuevo.', false);
                }
            } catch(e) {
                const typing = document.getElementById('typing-indicator');
                if (typing) typing.closest('.msg-ia').remove();
                agregarMensaje('Error de conexión. Intenta de nuevo.', false);
            }

            btn.disabled = false;
            input.focus();
        }

        function limpiarChat() {
            historial = [];
            chatBox.innerHTML = '';
            agregarMensaje('Chat reiniciado. ¿En qué puedo ayudarte?', false);
        }

        input.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });
    </script>
}