@{
    ViewData["Title"] = "Chat IA";
}

<div class="chat-page">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="chat-header-icon">
            <i class="bi bi-robot" aria-hidden="true"></i>
        </div>
        <div>
            <h2 class="chat-title">Chat IA</h2>
            <p class="chat-subtitle">Tu tutor académico personal · Pega imágenes con Ctrl+V</p>
        </div>
        <button type="button" class="btn-ghost chat-clear-btn" onclick="limpiarChat()">
            <i class="bi bi-trash3" aria-hidden="true"></i> Limpiar
        </button>
    </div>

    <div id="chatBox" class="chat-box">
        <div class="msg-ia">
            <div class="msg-avatar ia"><i class="bi bi-robot" aria-hidden="true"></i></div>
            <div class="msg-burbuja ia">
                Soy tu asistente de estudio. Pregúntame lo que quieras o pega una imagen de apuntes/ejercicios para que la analice.
            </div>
        </div>
    </div>

    <div class="chat-input-area">
        <div id="chatImagePreview" class="chat-image-preview" style="display:none;">
            <img id="chatPreviewImg" alt="Vista previa" />
            <button type="button" class="chat-image-remove" onclick="quitarImagenChat()" title="Quitar imagen" aria-label="Quitar imagen">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="chat-input-row">
            <label class="chat-attach-btn" for="chatFileInput" title="Adjuntar imagen">
                <i class="bi bi-image" aria-hidden="true"></i>
                <input type="file" id="chatFileInput" accept="image/*" hidden />
            </label>
            <textarea id="inputMsg"
                      placeholder="Escribe tu pregunta o pega una imagen (Ctrl+V)..."
                      aria-label="Mensaje para el asistente"
                      rows="1"
                      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();enviar();}"></textarea>
            <button type="button" onclick="enviar()" id="btnEnviar" class="chat-send-btn" aria-label="Enviar mensaje" title="Enviar mensaje">
                <i class="bi bi-send-fill" aria-hidden="true"></i>
            </button>
        </div>
        <p class="chat-disclaimer">La IA puede cometer errores. Las imágenes se comprimen para ahorrar tokens.</p>
    </div>
</div>

@section Scripts {
    <script>
        let historial = [];
        let imagenPendiente = null;
        const chatBox = document.getElementById('chatBox');
        const input = document.getElementById('inputMsg');
        const btn = document.getElementById('btnEnviar');
        const iniciales = '@(User.Identity?.Name?.Substring(0, Math.Min(User.Identity?.Name?.Length ?? 2, 2)).ToUpper() ?? "U")';

        function scrollAbajo() {
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function escHtml(t) {
            const d = document.createElement('div');
            d.textContent = t;
            return d.innerHTML;
        }

        function agregarMensaje(texto, esUsuario, esTyping = false, imagenUrl = null) {
            const div = document.createElement('div');
            div.className = esUsuario ? 'msg-user' : 'msg-ia';
            const avatar = `<div class="msg-avatar ${esUsuario ? 'user' : 'ia'}">${esUsuario ? iniciales : '<i class="bi bi-robot" aria-hidden="true"></i>'}</div>`;
            let contenido = esTyping ? texto : escHtml(texto).replace(/\n/g, '<br>');
            if (imagenUrl && esUsuario) {
                contenido = `<img src="${imagenUrl}" class="msg-chat-img" alt="Imagen" />` + (texto ? `<div class="mt-2">${contenido}</div>` : '');
            }
            const burbuja = `<div class="msg-burbuja ${esUsuario ? 'user' : 'ia'} ${esTyping ? 'typing' : ''}" id="${esTyping ? 'typing-indicator' : ''}">${contenido}</div>`;
            div.innerHTML = esUsuario ? burbuja + avatar : avatar + burbuja;
            chatBox.appendChild(div);
            scrollAbajo();
            return div;
        }

        function comprimirImagen(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = new Image();
                    img.onload = () => {
                        const maxW = 900;
                        const scale = Math.min(1, maxW / img.width);
                        const w = Math.round(img.width * scale);
                        const h = Math.round(img.height * scale);
                        const canvas = document.createElement('canvas');
                        canvas.width = w;
                        canvas.height = h;
                        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                        resolve(canvas.toDataURL('image/jpeg', 0.72));
                    };
                    img.onerror = reject;
                    img.src = e.target.result;
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        async function setImagenChat(file) {
            if (!file || !file.type.startsWith('image/')) return;
            if (file.size > 5 * 1024 * 1024) {
                Sugoi.toast.error('La imagen no puede superar 5 MB.');
                return;
            }
            imagenPendiente = await comprimirImagen(file);
            document.getElementById('chatPreviewImg').src = imagenPendiente;
            document.getElementById('chatImagePreview').style.display = 'flex';
        }

        function quitarImagenChat() {
            imagenPendiente = null;
            document.getElementById('chatImagePreview').style.display = 'none';
            document.getElementById('chatPreviewImg').src = '';
            document.getElementById('chatFileInput').value = '';
        }

        document.getElementById('chatFileInput').addEventListener('change', e => {
            if (e.target.files?.[0]) setImagenChat(e.target.files[0]);
        });

        input.addEventListener('paste', e => {
            const items = e.clipboardData?.items;
            if (!items) return;
            for (const item of items) {
                if (item.type.startsWith('image/')) {
                    e.preventDefault();
                    setImagenChat(item.getAsFile());
                    break;
                }
            }
        });

        async function enviar() {
            const msg = input.value.trim();
            if (!msg && !imagenPendiente) return;

            const imgEnviar = imagenPendiente;
            agregarMensaje(msg || '(Imagen adjunta)', true, false, imgEnviar);
            historial.push({ texto: msg, esUsuario: true });
            input.value = '';
            input.style.height = 'auto';
            quitarImagenChat();
            btn.disabled = true;

            agregarMensaje('Escribiendo...', false, true);

            try {
                const data = await Sugoi.apiPost('/Chat/Enviar', {
                    mensaje: msg,
                    imagen: imgEnviar || null
                });
                quitarTyping();
                agregarMensaje(data.respuesta, false);
                historial.push({ texto: data.respuesta, esUsuario: false });
            } catch (err) {
                quitarTyping();
                agregarMensaje(err.message || 'Hubo un error al obtener respuesta. Intenta de nuevo.', false);
                Sugoi.toast.error(err.message);
            } finally {
                btn.disabled = false;
                input.focus();
            }
        }

        function quitarTyping() {
            document.getElementById('typing-indicator')?.closest('.msg-ia')?.remove();
        }

        function limpiarChat() {
            historial = [];
            quitarImagenChat();
            chatBox.innerHTML = '';
            agregarMensaje('Chat reiniciado. ¿En qué puedo ayudarte?', false);
        }

        input.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });
    </script>
}
