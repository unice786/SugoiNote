<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SugoiNote</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <div class="sidebar">
        <a class="sidebar-brand" href="/Home/Index">
            <span class="brand-icon">S</span>
            SugoiNote
        </a>
        <nav class="sidebar-nav">
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/Home/Index">
                <i class="bi bi-house-door"></i> Inicio
            </a>
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Apuntes" ? "active" : "")" href="/Apuntes/Index">
                <i class="bi bi-journal-text"></i> Mis Apuntes
            </a>
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resumenes" ? "active" : "")" href="/Resumenes/Index">
                <i class="bi bi-file-earmark-text"></i> Mis Resúmenes
            </a>
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Examenes" ? "active" : "")" href="/Examenes/Index">
                <i class="bi bi-clipboard-check"></i> Exámenes
            </a>
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chat" ? "active" : "")" href="/Chat/Index">
                <i class="bi bi-chat-dots"></i> Chat IA
            </a>
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Comunidad" ? "active" : "")" href="/Comunidad/Index">
                <i class="bi bi-people"></i> Comunidad
            </a>
            <a class="nav-link-sugoi @(ViewContext.RouteData.Values["controller"]?.ToString() == "Perfil" ? "active" : "")" href="/Perfil/Index">
                <i class="bi bi-person-circle"></i> Perfil
            </a>
        </nav>
        <form action="/Auth/Logout" method="post" class="sidebar-logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout-btn">
                <i class="bi bi-box-arrow-left"></i> Cerrar sesión
            </button>
        </form>
    </div>
    <div class="main-content">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>