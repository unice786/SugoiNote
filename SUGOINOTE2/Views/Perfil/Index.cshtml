@model SugoiNote.Models.ViewModels.PerfilVM
@using System.Text.Json
@{
    ViewData["Title"] = "Mi Perfil";
    var tasaColor = Model.TasaApuntesMes >= 0 ? "var(--success)" : "var(--danger)";
    var tasaIcon = Model.TasaApuntesMes >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right";
    var tasaTexto = Model.TasaApuntesMes >= 0 ? $"+{Model.TasaApuntesMes}%" : $"{Model.TasaApuntesMes}%";
}

<div class="mb-4">
    <h2 style="font-weight:800;font-size:1.6rem;margin-bottom:4px;">Mi Perfil</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Gestiona tu información y revisa tu progreso</p>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="glass-card p-4 text-center">
            <div class="perfil-photo-wrap">
                <div id="fotoPerfilIniciales" class="perfil-photo-fallback" style="@(!string.IsNullOrEmpty(Model.FotoPerfil) ? "display:none;" : "")">
                    @(Model.NombreCompleto.Length >= 2 ? Model.NombreCompleto.Substring(0, 2).ToUpper() : "U")
                </div>
                <img id="fotoPerfilDisplay" src="@(Model.FotoPerfil ?? "")" alt="Foto de perfil" class="perfil-photo-img" style="@(string.IsNullOrEmpty(Model.FotoPerfil) ? "display:none;" : "")" />
                <label class="perfil-photo-edit" for="inputFotoPerfil" title="Cambiar foto">
                    <i class="bi bi-camera" aria-hidden="true"></i>
                    <input type="file" id="inputFotoPerfil" accept="image/*" hidden />
                </label>
            </div>
            <h4 style="font-weight:800;margin-bottom:4px;" id="nombreDisplay">@Model.NombreCompleto</h4>
            <p style="color:var(--text-muted);font-size:0.85rem;margin-bottom:16px;" id="correoDisplay">@Model.Correo</p>
            <button type="button" class="btn-ghost btn-sm" id="btnQuitarFoto" style="@(string.IsNullOrEmpty(Model.FotoPerfil) ? "display:none;" : "")" onclick="quitarFotoPerfil()">
                <i class="bi bi-trash" aria-hidden="true"></i> Quitar foto
            </button>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-person-fill" aria-hidden="true" style="color:var(--accent);"></i>
                <h5 style="font-weight:700;margin:0;">Información Personal</h5>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="sugoi-label" for="inputNombre">Nombre Completo</label>
                    <input type="text" id="inputNombre" class="sugoi-input" value="@Model.NombreCompleto" />
                </div>
                <div class="col-md-6">
                    <label class="sugoi-label" for="inputCorreo">Correo Electrónico</label>
                    <input type="email" id="inputCorreo" class="sugoi-input" value="@Model.Correo" />
                </div>
            </div>
            <div id="msgGuardado" style="display:none;margin-top:12px;">
                <span style="color:var(--success);font-size:0.85rem;"><i class="bi bi-check-circle" aria-hidden="true"></i> Cambios guardados</span>
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button type="button" class="btn-sugoi" onclick="guardarPerfil()">
                    <i class="bi bi-floppy" aria-hidden="true"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ESTADÍSTICAS -->
<div class="mt-4">
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-graph-up-arrow" aria-hidden="true" style="color:var(--accent);"></i>
        <h5 style="font-weight:800;margin:0;">Estadísticas de estudio</h5>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-card-purple">
                <div class="stat-card-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></div>
                <div class="stat-card-value">@Model.ApuntesEsteMes</div>
                <div class="stat-card-label">Apuntes este mes</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-card-green">
                <div class="stat-card-icon"><i class="@tasaIcon" aria-hidden="true"></i></div>
                <div class="stat-card-value" style="color:@tasaColor;">@tasaTexto</div>
                <div class="stat-card-label">vs mes anterior</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-card-blue">
                <div class="stat-card-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></div>
                <div class="stat-card-value">@Model.DiasActivos30</div>
                <div class="stat-card-label">Días activos (30d)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-card-amber">
                <div class="stat-card-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></div>
                <div class="stat-card-value">@Model.TotalExamenes</div>
                <div class="stat-card-label">Exámenes generados</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h6 class="stat-chart-title">Actividad mensual</h6>
                <p class="stat-chart-sub">Apuntes y exámenes en los últimos 6 meses</p>
                <div class="stat-chart-wrap">
                    <canvas id="chartActividad"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card p-4 h-100">
                <h6 class="stat-chart-title">Distribución total</h6>
                <p class="stat-chart-sub">Tu actividad acumulada</p>
                <div class="stat-chart-wrap stat-chart-donut">
                    <canvas id="chartDistribucion"></canvas>
                </div>
                <div class="stat-legend">
                    <div><span class="stat-dot" style="background:var(--accent);"></span> Apuntes: @Model.TotalApuntes</div>
                    <div><span class="stat-dot" style="background:var(--accent-soft-2);"></span> Resúmenes: @Model.TotalResumenes</div>
                    <div><span class="stat-dot" style="background:var(--success);"></span> Exámenes: @Model.TotalExamenes</div>
                    <div><span class="stat-dot" style="background:var(--info);"></span> Comunidad: @Model.TotalPublicaciones</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        let fotoPerfilData = @Html.Raw(JsonSerializer.Serialize(Model.FotoPerfil ?? ""));

        const meses = @Html.Raw(JsonSerializer.Serialize(Model.ApuntesPorMes.Select(m => m.Etiqueta)));
        const apuntesMes = @Html.Raw(JsonSerializer.Serialize(Model.ApuntesPorMes.Select(m => m.Cantidad)));
        const examenesMes = @Html.Raw(JsonSerializer.Serialize(Model.ExamenesPorMes.Select(m => m.Cantidad)));

        // Los gráficos se pintan en <canvas>, que NO resuelve var() ni hereda los
        // tokens: hay que leer el valor ya calculado del tema activo. Con literales
        // fijos (antes 'rgba(255,255,255,0.06)') en modo claro el texto y las líneas
        // quedaban casi invisibles sobre blanco.
        const token = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
        const tinte = (n, a) => {
            const h = token(n).replace('#', '');
            const full = h.length === 3 ? h.split('').map(c => c + c).join('') : h;
            const num = parseInt(full.slice(0, 6), 16);
            return `rgba(${(num >> 16) & 255},${(num >> 8) & 255},${num & 255},${a})`;
        };

        Chart.defaults.color = token('--text-muted');
        Chart.defaults.borderColor = token('--border-subtle');
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";

        new Chart(document.getElementById('chartActividad'), {
            type: 'bar',
            data: {
                labels: meses,
                datasets: [
                    {
                        label: 'Apuntes',
                        data: apuntesMes,
                        backgroundColor: tinte('--accent', 0.75),
                        borderRadius: 8,
                        borderSkipped: false
                    },
                    {
                        label: 'Exámenes',
                        data: examenesMes,
                        backgroundColor: tinte('--success', 0.75),
                        borderRadius: 8,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 12, padding: 16 } } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } },
                    x: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('chartDistribucion'), {
            type: 'doughnut',
            data: {
                labels: ['Apuntes', 'Resúmenes', 'Exámenes', 'Comunidad'],
                datasets: [{
                    data: [@Model.TotalApuntes, @Model.TotalResumenes, @Model.TotalExamenes, @Model.TotalPublicaciones],
                    backgroundColor: [token('--accent'), token('--accent-soft-3'), token('--success'), token('--info')],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: { legend: { display: false } }
            }
        });

        document.getElementById('inputFotoPerfil').addEventListener('change', async e => {
            const file = e.target.files?.[0];
            if (!file) return;
            if (file.size > 2 * 1024 * 1024) {
                Sugoi.toast.error('La foto no puede superar 2 MB.');
                e.target.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = async ev => {
                const nuevaFoto = ev.target.result;
                try {
                    await Sugoi.apiPost('/Perfil/ActualizarFoto', { fotoPerfil: nuevaFoto });
                } catch (err) {
                    // Antes se mostraba "guardado" aunque el servidor hubiera fallado.
                    Sugoi.toast.error(err.message);
                    e.target.value = '';
                    return;
                }
                fotoPerfilData = nuevaFoto;
                mostrarFotoPreview(fotoPerfilData);
                document.getElementById('btnQuitarFoto').style.display = 'inline-flex';
                mostrarMsgGuardado();
                Sugoi.toast.ok('Foto actualizada.');
            };
            reader.readAsDataURL(file);
        });

        function mostrarFotoPreview(src) {
            document.getElementById('fotoPerfilDisplay').src = src;
            document.getElementById('fotoPerfilDisplay').style.display = 'block';
            document.getElementById('fotoPerfilIniciales').style.display = 'none';
        }

        async function quitarFotoPerfil() {
            try {
                await Sugoi.apiPost('/Perfil/ActualizarFoto', { fotoPerfil: '' });
            } catch (err) {
                Sugoi.toast.error(err.message);
                return;
            }
            fotoPerfilData = '';
            document.getElementById('fotoPerfilDisplay').style.display = 'none';
            document.getElementById('fotoPerfilDisplay').src = '';
            document.getElementById('fotoPerfilIniciales').style.display = 'flex';
            document.getElementById('btnQuitarFoto').style.display = 'none';
            document.getElementById('inputFotoPerfil').value = '';
            mostrarMsgGuardado();
            Sugoi.toast.ok('Foto eliminada.');
        }

        async function guardarPerfil() {
            const nombre = document.getElementById('inputNombre').value.trim();
            const correo = document.getElementById('inputCorreo').value.trim();
            if (!nombre) { Sugoi.toast.error('El nombre no puede estar vacío'); return; }
            if (!correo || correo.indexOf('@@') === -1) { Sugoi.toast.error('Ingresa un correo válido'); return; }

            try {
                await Sugoi.apiPost('/Perfil/Actualizar', { nombreCompleto: nombre, correo: correo });
            } catch (err) {
                Sugoi.toast.error(err.message);
                return;
            }

            document.getElementById('nombreDisplay').textContent = nombre;
            document.getElementById('correoDisplay').textContent = correo;
            const fallback = document.getElementById('fotoPerfilIniciales');
            if (fallback.style.display !== 'none') {
                fallback.textContent = nombre.length >= 2 ? nombre.substring(0, 2).toUpperCase() : 'U';
            }
            mostrarMsgGuardado();
            Sugoi.toast.ok('Cambios guardados.');
        }

        function mostrarMsgGuardado() {
            document.getElementById('msgGuardado').style.display = 'block';
            setTimeout(() => document.getElementById('msgGuardado').style.display = 'none', 3000);
        }
    </script>
}
