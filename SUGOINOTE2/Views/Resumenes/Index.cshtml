@model IEnumerable<SugoiNote.Models.ViewModels.ApunteVM>
@{
    ViewData["Title"] = "Mis Resúmenes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight:800;font-size:1.6rem;margin-bottom:4px;">Mis Resúmenes</h2>
        <p style="color:var(--text-muted);font-size:0.85rem;margin:0;">Resúmenes generados con IA desde tus apuntes</p>
    </div>
    <button type="button" class="btn-sugoi" onclick="abrirModal()">
        <i class="bi bi-stars" aria-hidden="true"></i> Generar Resumen
    </button>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3" id="lista-resumenes">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="note-card"
                     data-apunte-id="@item.ApunteId"
                     data-titulo="@item.TituloNota"
                     role="button"
                     tabindex="0"
                     style="cursor:pointer;">
                    <div class="note-card-icon" style="background:color-mix(in srgb, var(--accent) 10%, transparent);">
                        <i class="bi bi-stars" aria-hidden="true" style="color:var(--accent);"></i>
                    </div>
                    <div class="note-card-title">@item.TituloNota</div>
                    <div class="note-card-date">@(item.FechaRegistro?.ToString("dd MMM yyyy"))</div>
                    <span class="materia-badge" style="margin-top:8px;display:inline-block;">Resumen IA</span>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5" id="empty-state">
        <div style="width:72px;height:72px;background:color-mix(in srgb, var(--accent) 8%, transparent);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <i class="bi bi-stars" aria-hidden="true" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h5 style="font-weight:700;margin-bottom:8px;">Aún no tienes resúmenes</h5>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:20px;">Selecciona un apunte y la IA generará un resumen por ti</p>
        <button type="button" class="btn-sugoi" onclick="abrirModal()">
            <i class="bi bi-stars" aria-hidden="true"></i> Crear mi primer resumen
        </button>
    </div>
}

<!-- MODAL SELECCIONAR APUNTE -->
<div class="modal-overlay" id="modalGenerar">
    <div class="modal-box">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <p class="modal-title" style="margin:0;"><i class="bi bi-stars" aria-hidden="true" style="color:var(--accent);margin-right:8px;"></i>Generar Resumen</p>
            <button type="button" aria-label="Cerrar" onclick="cerrarModal()" style="background:none;border:none;color:var(--text-muted);font-size:1.3rem;cursor:pointer;">&times;</button>
        </div>
        <div class="mb-4">
            <label class="sugoi-label" for="selectApunte">Selecciona un apunte</label>
            <select id="selectApunte" class="sugoi-input" style="padding:10px 14px !important;">
                <option value="">-- Elige un apunte --</option>
            </select>
        </div>
        <div id="generandoMsg" style="display:none;text-align:center;padding:20px 0;">
            <div style="width:40px;height:40px;border:3px solid color-mix(in srgb, var(--accent) 20%, transparent);border-top-color:var(--accent);border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 12px;"></div>
            <p style="color:var(--text-muted);font-size:0.88rem;">La IA está generando tu resumen...</p>
        </div>
        <div class="d-flex gap-2" id="botonesModal">
            <button type="button" class="btn-sugoi flex-fill justify-content-center" onclick="generarResumen()">
                <i class="bi bi-stars" aria-hidden="true"></i> Generar
            </button>
            <button type="button" class="btn-ghost" onclick="cerrarModal()">Cancelar</button>
        </div>
    </div>
</div>

<!-- PANEL VER RESUMEN -->
<div class="modal-overlay" id="panelResumen">
    <div class="modal-box" style="max-width:780px;max-height:85vh;overflow-y:auto;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <p class="modal-title" style="margin:0;" id="tituloResumenPanel">Resumen</p>
                <span style="font-size:0.75rem;color:var(--accent);">Generado con IA</span>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn-sugoi" onclick="descargarPDF()" style="padding:8px 16px;font-size:0.82rem;">
                    <i class="bi bi-download" aria-hidden="true"></i> Descargar PDF
                </button>
                <button type="button" aria-label="Cerrar" onclick="cerrarPanel()" style="background:none;border:none;color:var(--text-muted);font-size:1.3rem;cursor:pointer;">&times;</button>
            </div>
        </div>
        <div id="contenidoResumen" style="color:var(--text-primary);line-height:1.8;font-size:0.95rem;"></div>
    </div>
</div>

<style>
@@keyframes spin { to { transform: rotate(360deg); } }
#contenidoResumen h2 { font-size:1.2rem;font-weight:700;margin:20px 0 8px;color:var(--text-primary); }
#contenidoResumen h3 { font-size:1rem;font-weight:600;margin:16px 0 6px;color:var(--accent); }
#contenidoResumen p { color:var(--text-secondary);margin-bottom:10px; }
#contenidoResumen ul { padding-left:20px;color:var(--text-secondary); }
#contenidoResumen li { margin-bottom:4px; }
#contenidoResumen code { background:color-mix(in srgb, var(--accent) 10%, transparent);color:var(--accent);padding:2px 8px;border-radius:5px;font-size:0.88rem; }
#contenidoResumen strong { color:var(--text-primary); }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
    let resumenActualTitulo = '';

    async function abrirModal() {
        document.getElementById('modalGenerar').classList.add('open');
        const sel = document.getElementById('selectApunte');
        try {
            const data = await Sugoi.apiGet('/Resumenes/GetApuntes');
            sel.innerHTML = '<option value="">-- Elige un apunte --</option>';
            (data || []).forEach(a => {
                const opt = document.createElement('option');
                opt.value = a.apunteId;
                opt.textContent = a.tituloNota;
                sel.appendChild(opt);
            });
        } catch (err) {
            Sugoi.toast.error(err.message);
        }
    }

    function cerrarModal() { document.getElementById('modalGenerar').classList.remove('open'); }
    function cerrarPanel() { document.getElementById('panelResumen').classList.remove('open'); }

    document.getElementById('modalGenerar').addEventListener('click', e => { if (e.target === document.getElementById('modalGenerar')) cerrarModal(); });
    document.getElementById('panelResumen').addEventListener('click', e => { if (e.target === document.getElementById('panelResumen')) cerrarPanel(); });

    async function generarResumen() {
        const sel = document.getElementById('selectApunte');
        const apunteId = sel.value;
        const titulo = sel.options[sel.selectedIndex]?.text || '';
        if (!apunteId) { Sugoi.toast.error('Selecciona un apunte'); return; }

        document.getElementById('botonesModal').style.display = 'none';
        document.getElementById('generandoMsg').style.display = 'block';

        try {
            const data = await Sugoi.apiPost('/Resumenes/Generar', { apunteId });
            cerrarModal();
            verResumenDirecto(data.resumen, titulo);
            Sugoi.toast.ok('Resumen generado.');
            setTimeout(() => location.reload(), 500);
        } catch (err) {
            Sugoi.toast.error(err.message);
        } finally {
            document.getElementById('botonesModal').style.display = 'flex';
            document.getElementById('generandoMsg').style.display = 'none';
        }
    }

    // El id y el título llegan por data-*, no inyectados en un onclick.
    document.querySelectorAll('.note-card[data-apunte-id]').forEach(el => {
        el.addEventListener('click', () => verResumen(el.dataset.apunteId, el.dataset.titulo));
        el.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                verResumen(el.dataset.apunteId, el.dataset.titulo);
            }
        });
    });

    async function verResumen(apunteId, titulo) {
        try {
            const data = await Sugoi.apiGet(`/Resumenes/ObtenerResumen?apunteId=${encodeURIComponent(apunteId)}`);
            if (!data || !data.resumen) {
                Sugoi.toast.error('Este apunte todavía no tiene resumen generado.');
                return;
            }
            verResumenDirecto(data.resumen, titulo);
        } catch (err) {
            Sugoi.toast.error(err.message);
        }
    }

    function verResumenDirecto(html, titulo) {
        resumenActualTitulo = titulo;
        document.getElementById('tituloResumenPanel').textContent = titulo;
        document.getElementById('contenidoResumen').innerHTML = html;
        document.getElementById('panelResumen').classList.add('open');
    }

    async function descargarPDF() {
        // Si el CDN no cargó (bloqueado por la CSP o sin conexion), avisamos en
        // lugar de fallar en silencio al pulsar el boton.
        if (!window.jspdf || typeof html2canvas !== 'function') {
            alert('No se pudo cargar el generador de PDF. Revisa tu conexión y recarga la página.');
            return;
        }
        const { jsPDF } = window.jspdf;
        const el = document.getElementById('contenidoResumen');
        // El fondo se toma del tema activo: con un color fijo el PDF salía negro
        // sobre papel blanco en modo claro.
        const bg = getComputedStyle(document.body).backgroundColor;
        const canvas = await html2canvas(el, { backgroundColor: bg, scale: 2 });
        const img = canvas.toDataURL('image/png');
        const pdf = new jsPDF('p', 'mm', 'a4');
        const w = pdf.internal.pageSize.getWidth();
        const h = (canvas.height * w) / canvas.width;
        pdf.addImage(img, 'PNG', 0, 10, w, h);
        pdf.save(`Resumen - ${resumenActualTitulo}.pdf`);
    }
</script>
}